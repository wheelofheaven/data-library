{
  "schemaVersion": 2,
  "bookCode": "EG",
  "bookSlug": "eridu-genesis",
  "n": 4,
  "paragraphs": [
    { "n": 1, "refId": "EG-4:1", "text": "[About twelve lines broken away before the first traces of lines in this column.]" },
    { "n": 13, "refId": "EG-4:13", "text": "[...] revealed secrets [caused] to see [...]" },
    { "n": 16, "refId": "EG-4:16", "text": "[...] in the garden" },
    { "n": 18, "refId": "EG-4:18", "text": "[In Ebaraguldu] stand." },
    { "n": 19, "refId": "EG-4:19", "text": "In Erabgaran stand." },
    { "n": 20, "refId": "EG-4:20", "text": "In the temple may my guide dwell," },
    { "n": 21, "refId": "EG-4:21", "text": "May Enki my guide dwell." },
    { "n": 22, "refId": "EG-4:22", "text": "Two \"humbles\" who fill with water," },
    { "n": 23, "refId": "EG-4:23", "text": "The water course filled with water." },
    { "n": 24, "refId": "EG-4:24", "text": "The canal they filled with water." },
    { "n": 25, "refId": "EG-4:25", "text": "The barren land they irrigated(?) [...]" },
    { "n": 26, "refId": "EG-4:26", "text": "The gardener [...]" },
    { "n": 27, "refId": "EG-4:27", "text": "A secret [...]" },
    { "n": 28, "refId": "EG-4:28", "text": "Who art thou? the garden [...]" },
    { "n": 29, "refId": "EG-4:29", "text": "Enki to the gardener [...]" },
    { "n": 30, "refId": "EG-4:30", "text": "[Here four lines broken away.]" },
    { "n": 34, "refId": "EG-4:34", "text": "[...]" },
    { "n": 35, "refId": "EG-4:35", "text": "In E-baraguldu he stood." },
    { "n": 36, "refId": "EG-4:36", "text": "In E-rabgaran he stood. His seat he took." },
    { "n": 37, "refId": "EG-4:37", "text": "Enki beheld him. A scepter in his hand he grasped." },
    { "n": 38, "refId": "EG-4:38", "text": "Enki for Tagtug waited [...]" },
    { "n": 39, "refId": "EG-4:39", "text": "In his temple he cried, \"Open the door, open the door." },
    { "n": 40, "refId": "EG-4:40", "text": "Who is it that thou art?\"" },
    { "n": 41, "refId": "EG-4:41", "text": "\"I am a gardener joyful [...]\"" },
    { "n": 42, "refId": "EG-4:42", "text": "[...] I will cause to be given unto thee." },
    { "n": 43, "refId": "EG-4:43", "text": "The divine Tagtug with glad heart opened the temple's door." },
    { "n": 44, "refId": "EG-4:44", "text": "Enki unto the divine Tagtug revealed secrets." },
    { "n": 45, "refId": "EG-4:45", "text": "[...] he gave unto him joyously." },
    { "n": 46, "refId": "EG-4:46", "text": "In E-baraguldu he gave unto him." },
    { "n": 47, "refId": "EG-4:47", "text": "In Erabgaran he gave unto him." },
    { "n": 48, "refId": "EG-4:48", "text": "The divine Tagtug was confided; the left hand he raised; the (right) hand he composed." }
  ]
}
