{
  "_meta": {
    "title": "Wheel of Heaven — ETTMTTP cross-language glossary & scripture-handling spec",
    "purpose": "Authoritative, reviewable record of every recurring loaded term and the scripture-quotation policy. All chapters MUST be built against this. Inherits canonical vocabulary, registers, and scripture-handling policy from TBWTT's glossary; same author, canon, divine-name carve-outs apply. ETTMTTP-specific terms (interstellar travel, guides, planet description) accumulate here during the translation pass.",
    "book": "Extraterrestrials Took Me to Their Planet (Les Extra-Terrestres m'ont emmené sur leur planète), bookCode ETTMTTP",
    "i18n_key_order": ["en", "de", "es", "ru", "ja", "ko", "zh", "zh-Hant"],
    "registers": {
      "dialogue": "formal/deferential: de=Sie, es=usted, ru=formal вы (lowercase), ja=です・ます, ko=합쇼체, zh=您",
      "narration": "each language's standard literary plain form",
      "zh-Hant": "derived from zh by OpenCC OpenCC('s2t'); orthographic only, region-neutral; never hand-edited independently"
    },
    "open_inconsistencies_resolved_here": [
      "ja 'tree of life' appeared in TBWTT ch2 as BOTH いのちの木 and 命の木 — LOCKED to いのちの木 going forward (inherited from TBWTT glossary)."
    ],
    "structural_notes": [
      "ETTMTTP ch2 ends mid-sentence in the 1998 French PDF source: '…Les Elohim commençaient à' (preserved with explicit '…' in chapter-2.json paragraph [116]). The continuation exists in the 2005 IRM English EPUB but is NOT in the French source. Translation should preserve this truncation, NOT back-translate from English.",
      "ETTMTTP ch3 is largely a Yahweh monologue (most of 263 paragraphs attributed to Yahweh, mirroring TBWTT ch3's teaching cadence). Dialogue register applies throughout."
    ]
  },
  "scripture_policy": {
    "decision": "Quoted Bible passages use each language's recognized public-domain scripture text and cadence. Vorilhon's commentary is translated normally (faithful to the book).",
    "base_editions": {
      "en": "King James Version (1611/1769), public domain",
      "de": "Lutherbibel 1912, public domain",
      "es": "Reina-Valera 1909, public domain",
      "ru": "Russian Synodal (1876), public domain",
      "zh": "Chinese Union Version (和合本, 1919), public domain",
      "zh-Hant": "OpenCC s2t of the zh CUV rendering (orthographic only)",
      "ja": "public-domain literary scriptural register (文語/口語 tradition); NOT a copyrighted modern edition",
      "ko": "public-domain scriptural register (개역 tradition); NOT a copyrighted modern edition"
    },
    "carve_outs": {
      "rule": "Apply ONLY where the adjacent commentary depends on the wording; elsewhere follow the base edition verbatim.",
      "elohim": "Where the French verse has 'Elohim', keep 'Elohim' (NOT God/Gott/Dios/Бог/神/하나님). The book's thesis is that 'Elohim' was mistranslated as God.",
      "divine_name": "Where the French verse uses the name 'Iahvé' (or 'Yahweh'), keep it as the NAME per the divine_name glossary row — NOT 'the LORD / l'Éternel / Господь / 主'. Needed because commentary treats 'Iahvé Elohim' as a visible compound.",
      "no_book_interpolation": "Do NOT import the book's non-canonical interpolations into the verse body (e.g. Gen III-22 'grâce à la science'); use canonical wording. Preserve an interpolation only if the commentary explicitly quotes it back."
    },
    "speaker_tag": "The paragraph field speaker:'Yahweh' is a STRUCTURAL identifier, never translated or altered, distinct from the divine NAME inside verse text.",
    "citation_form": "Preserve the book's own citation format and parenthetical placement, e.g. «…». (Genèse, I-1) → localized book name + same numerals. Truncated/odd citations in the source (split across paragraphs) are preserved as-is structurally.",
    "mixed_paragraphs": "When a paragraph is commentary + an embedded quoted span, translate the commentary frame normally and render only the quoted span per the base edition + carve-outs."
  },
